<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sub_cabecalho" pageWidth="555" pageHeight="842" columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">
	<parameter name="idProjeto" class="java.lang.String"/>
	<queryString>
		<![CDATA[MATCH (w:Workpack:Project)-[:BELONGS_TO]->(pl:Plan)
WHERE id(w) = $P!{idProjeto}

// Nome de propriedade e comparado NORMALIZADO: minusculas, sem espaco nas pontas
// e sem ZERO WIDTH SPACE (U+200B). O cadastro tem nomes que so diferem por esses
// caracteres invisiveis — ha duas PropertyModel "Data de Inicio", uma com U+200B —
// e comparar por literal falha em silencio, devolvendo campo vazio.
OPTIONAL MATCH (w)<-[:FEATURES]-(:Property)-[:GROUPS*0..2]->(p:Property)-[:IS_DRIVEN_BY]->(pm:PropertyModel)
WITH w, pl, collect([toLower(trim(replace(pm.name, '\u200B', ''))),
                     coalesce(p.value, toString(p.date), toString(p.selectedValue))]) AS pairs

// Partes interessadas inclui Organization, nao so Person: ambos carregam o rotulo
// Actor e ambos sao cadastrados como stakeholder.
OPTIONAL MATCH (pe:Actor)-[:IS_STAKEHOLDER_IN]->(w)
WITH w, pl, pairs, collect(DISTINCT pe.name) AS stk

// Linha de base: a ativa, nao a lista inteira. Um projeto acumula propostas.
OPTIONAL MATCH (b:Baseline)-[:IS_BASELINED_BY|IS_PROPOSED_BY]-(w)
WITH w, pl, pairs, stk,
     collect(DISTINCT CASE WHEN coalesce(b.active,false) THEN b.name END) AS blAtiva,
     collect(DISTINCT b.name) AS blTodas
WITH w, pl, pairs, stk,
     [x IN blAtiva WHERE x IS NOT NULL] + [x IN blTodas WHERE x IS NOT NULL] AS bl

// Um mesmo campo do xlsx tem nomes diferentes conforme o PlanModel. Cada entrada
// abaixo lista os aliases conhecidos, ja normalizados.
WITH w, pl, stk, bl, pairs,
  [ap IN [
    {k:'programa',    a:['programa do ppa','programa']},
    {k:'responsavel', a:['responsável','responsavel','gerente','gerente/responsável']},
    {k:'publico',     a:['público-alvo','publico-alvo']},
    {k:'justif',      a:['justificativa']},
    {k:'resultados',  a:['resultados esperados']},
    {k:'dtinicio',    a:['data de início','data de inicio']},
    {k:'dtfim',       a:['data de término','data de termino','data prevista de término','data prevista de termino']},
    {k:'unidade',     a:['unidade gestora']},
    {k:'demais',      a:['demais unidades','demais unidades envolvidas','outras unidades envolvidas']},
    {k:'area',        a:['área de resultado','area de resultado']},
    {k:'capex',       a:['valor de investimento (capex)','valor de investimento','valor financeiro do investimento']},
    {k:'opex',        a:['valor de custeio (opex)','valor do custeio da operação']},
    {k:'valorunico',  a:['valor estimado do projeto']}
   ] | [ap.k, coalesce(head([x IN pairs WHERE x[0] IN ap.a AND x[1] IS NOT NULL AND x[1] <> '' | x[1]]), '')]] AS f

// Valor estimado: onde existe campo unico, usa-o; onde o modelo separa, soma CAPEX+OPEX.
WITH w, pl, stk, bl, f,
  head([x IN f WHERE x[0]='valorunico' | x[1]]) AS vUnico,
  toFloat(coalesce(head([x IN f WHERE x[0]='capex' AND x[1]<>'' | x[1]]),'0'))
+ toFloat(coalesce(head([x IN f WHERE x[0]='opex'  AND x[1]<>'' | x[1]]),'0')) AS vSoma
WITH w, pl, stk, bl, f,
  CASE WHEN vUnico <> '' THEN toFloat(vUnico) ELSE vSoma END AS valorTotal
UNWIND [
  ['ID',                              toString(id(w)),                                            null],
  ['Nome do Projeto',                 coalesce(w.name,''),                                        null],
  ['Plano',                           coalesce(pl.name,''),                                       null],
  ['Programa / Carteira Estratégica', head([x IN f WHERE x[0]='programa' | x[1]]),                 null],
  ['Área de Resultado',               head([x IN f WHERE x[0]='area' | x[1]]),                     null],
  ['Gerente / Responsável',           head([x IN f WHERE x[0]='responsavel' | x[1]]),              null],
  ['Partes Interessadas',             reduce(s='', n IN [x IN stk WHERE x IS NOT NULL] | CASE WHEN s='' THEN n ELSE s+', '+n END), null],
  ['Público-alvo',                    head([x IN f WHERE x[0]='publico' | x[1]]),                  null],
  ['Justificativa',                   head([x IN f WHERE x[0]='justif' | x[1]]),                   null],
  ['Resultados Esperados',            head([x IN f WHERE x[0]='resultados' | x[1]]),               null],
  ['Data de Início',                  CASE WHEN left(head([x IN f WHERE x[0]='dtinicio' | x[1]]),10) IS NULL OR left(head([x IN f WHERE x[0]='dtinicio' | x[1]]),10) = '' THEN '' ELSE substring(left(head([x IN f WHERE x[0]='dtinicio' | x[1]]),10),8,2)+'/'+substring(left(head([x IN f WHERE x[0]='dtinicio' | x[1]]),10),5,2)+'/'+substring(left(head([x IN f WHERE x[0]='dtinicio' | x[1]]),10),0,4) END,        null],
  ['Data Prevista de Término',        CASE WHEN left(head([x IN f WHERE x[0]='dtfim' | x[1]]),10) IS NULL OR left(head([x IN f WHERE x[0]='dtfim' | x[1]]),10) = '' THEN '' ELSE substring(left(head([x IN f WHERE x[0]='dtfim' | x[1]]),10),8,2)+'/'+substring(left(head([x IN f WHERE x[0]='dtfim' | x[1]]),10),5,2)+'/'+substring(left(head([x IN f WHERE x[0]='dtfim' | x[1]]),10),0,4) END,           null],
  ['Valor estimado do projeto',       '',                                                    valorTotal],
  ['Unidade Gestora',                 head([x IN f WHERE x[0]='unidade' | x[1]]),                  null],
  ['Demais unidades envolvidas',      head([x IN f WHERE x[0]='demais' | x[1]]),                   null],
  ['Linha de base',                   coalesce(head(bl),''),                                       null]
] AS row
RETURN row[0] AS campo, row[1] AS valor, row[2] AS valorNum]]>
	</queryString>
	<field name="campo"    class="java.lang.String"/>
	<field name="valor"    class="java.lang.String"/>
	<field name="valorNum" class="java.lang.Double"/>
	<detail>
		<band height="14">
			<textField>
				<reportElement stretchType="ContainerHeight" mode="Opaque" backcolor="#F2F5F8" x="0" y="0" width="170" height="14"/>
				<box leftPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box>
				<textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{campo}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="170" y="0" width="385" height="14">
					<printWhenExpression><![CDATA[$F{valorNum} == null]]></printWhenExpression>
				</reportElement>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box>
				<textElement verticalAlignment="Middle"><font size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{valor}]]></textFieldExpression>
			</textField>
			<textField pattern="¤ #,##0.00" isBlankWhenNull="true">
				<reportElement stretchType="ContainerHeight" x="170" y="0" width="385" height="14">
					<printWhenExpression><![CDATA[$F{valorNum} != null]]></printWhenExpression>
				</reportElement>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box>
				<textElement verticalAlignment="Middle"><font size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{valorNum}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<noData>
		<band height="14">
			<staticText><reportElement x="0" y="0" width="555" height="14"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box><textElement verticalAlignment="Middle"><font size="7" isItalic="true"/></textElement><text><![CDATA[Projeto não encontrado.]]></text></staticText>
		</band>
	</noData>
</jasperReport>
