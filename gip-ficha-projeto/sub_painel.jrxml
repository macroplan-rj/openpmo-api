<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sub_painel" pageWidth="555" pageHeight="842" columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">
	<parameter name="idProjeto" class="java.lang.String"/>
	<queryString>
		<![CDATA[MATCH (w:Workpack:Project)-[:BELONGS_TO]->(pl:Plan)
WHERE id(w) = $P!{idProjeto}
OPTIONAL MATCH (w)<-[:FEATURES]-(:Property)-[:GROUPS*0..2]->(p:Property)-[:IS_DRIVEN_BY]->(pm:PropertyModel)
WITH w, collect([pm.name, coalesce(p.value, toString(p.date), toString(p.selectedValue))]) AS pairs
OPTIONAL MATCH (b:Baseline)-[:IS_BASELINED_BY|IS_PROPOSED_BY]-(w)
WITH w, pairs, collect(DISTINCT b.name) AS bl
OPTIONAL MATCH (d:Workpack:Deliverable)-[:IS_IN*1..3]->(w)
OPTIONAL MATCH (sc:Schedule)-[:FEATURES]->(d)
OPTIONAL MATCH (st:Step)-[:COMPOSES]->(sc)
WITH w, pairs, bl, collect(DISTINCT d) AS entregas,
     sum(toFloat(coalesce(st.plannedWork,0))) AS planW,
     sum(toFloat(coalesce(st.actualWork,0)))  AS realW
// Risco liga-se por IS_FORSEEN_ON, nao por IS_REGISTERED_IN/RELATED_TO/FOR —
// nenhum dos tres tipos existe no grafo, e a consulta antiga devolvia sempre vazio.
// Alcanca tambem os riscos das entregas do projeto, nao so os do proprio projeto.
OPTIONAL MATCH (r:Risk)-[:IS_FORSEEN_ON]->(rw:Workpack)
WHERE rw = w OR (rw)-[:IS_IN*1..3]->(w)
WITH w, pairs, bl, entregas, planW, realW, collect(DISTINCT r.name) AS riscos
UNWIND (CASE WHEN size(entregas)=0 THEN [null] ELSE entregas END) AS ent
OPTIONAL MATCH (ent)<-[:FEATURES]-(:Property)-[:GROUPS*0..2]->(ep:Property)-[:IS_DRIVEN_BY]->(epm:PropertyModel)
WHERE epm.name = 'Situação'
WITH w, pairs, bl, entregas, planW, realW, riscos, collect(DISTINCT ep.value) AS sitEntregas
WITH w, bl, entregas, planW, realW, riscos, sitEntregas,
  [k IN ['Unidade gestora','Situação','Valor de investimento (CAPEX)','Valor de custeio (OPEX)']
   | [k, coalesce(head([x IN pairs WHERE x[0]=k AND x[1] IS NOT NULL | x[1]]), '')]] AS f
WITH w, bl, entregas, planW, realW, riscos, sitEntregas, f,
  toFloat(coalesce(head([x IN f WHERE x[0]='Valor de investimento (CAPEX)' AND x[1]<>'' | x[1]]),'0'))
+ toFloat(coalesce(head([x IN f WHERE x[0]='Valor de custeio (OPEX)'       AND x[1]<>'' | x[1]]),'0')) AS custoPrevisto
UNWIND [
  ['Nome do Projeto',                   coalesce(w.name,''),                                    null],
  ['Data de Referência',                toString(date()),                                       null],
  ['Linha de base',                     coalesce(head(bl),''),                                  null],
  ['Unidade Gestora',                   head([x IN f WHERE x[0]='Unidade gestora' | x[1]]),      null],
  ['Situação',                          head([x IN f WHERE x[0]='Situação' | x[1]]),             null],
  ['Custo total previsto',              '',                                            custoPrevisto],
  ['Custo realizado',                   '— sem lançamento de custo realizado no ambiente',       null],
  ['Execução física planejada',         '',       CASE WHEN planW>0 THEN round(planW,2) ELSE null END],
  ['Execução física realizada',         '',       CASE WHEN planW>0 THEN round(realW,2) ELSE null END],
  ['% cumprimento físico',              '',       CASE WHEN planW>0 THEN round(100.0*realW/planW,2) ELSE null END],
  ['Execução financeira planejada (%)', '— depende de Conta de Custo vinculada às entregas',     null],
  ['Execução financeira realizada (%)', '— depende de Conta de Custo vinculada às entregas',     null],
  ['% cumprimento financeiro',          '— depende de Conta de Custo vinculada às entregas',     null],
  ['N° de Entregas cadastradas',        toString(size(entregas)),                               null],
  ['Status das Entregas',               reduce(s='', n IN [x IN sitEntregas WHERE x IS NOT NULL] | CASE WHEN s='' THEN n ELSE s+'; '+n END), null],
  ['Riscos',                            reduce(s='', n IN [x IN riscos      WHERE x IS NOT NULL] | CASE WHEN s='' THEN n ELSE s+'; '+n END), null]
] AS row
RETURN row[0] AS campo, row[1] AS valor, row[2] AS valorNum]]>
	</queryString>
	<field name="campo"    class="java.lang.String"/>
	<field name="valor"    class="java.lang.String"/>
	<field name="valorNum" class="java.lang.Double"/>
	<detail>
		<band height="14">
			<textField>
				<reportElement stretchType="ContainerHeight" mode="Opaque" backcolor="#F2F5F8" x="0" y="0" width="170" height="14"/>
				<box leftPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box>
				<textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{campo}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="170" y="0" width="385" height="14">
					<printWhenExpression><![CDATA[$F{valorNum} == null]]></printWhenExpression>
				</reportElement>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box>
				<textElement verticalAlignment="Middle"><font size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{valor}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement stretchType="ContainerHeight" x="170" y="0" width="385" height="14">
					<printWhenExpression><![CDATA[$F{valorNum} != null]]></printWhenExpression>
				</reportElement>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box>
				<textElement verticalAlignment="Middle"><font size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{valorNum}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<noData>
		<band height="14">
			<staticText><reportElement x="0" y="0" width="555" height="14"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box><textElement verticalAlignment="Middle"><font size="7" isItalic="true"/></textElement><text><![CDATA[Projeto não encontrado.]]></text></staticText>
		</band>
	</noData>
</jasperReport>
