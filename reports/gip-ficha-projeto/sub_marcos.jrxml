<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sub_marcos" pageWidth="555" pageHeight="842" columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">
	<parameter name="idProjeto" class="java.lang.String"/>
	<queryString>
		<![CDATA[MATCH (m:Workpack:Milestone)-[:IS_IN]->(parent:Workpack)
MATCH (m)-[:IS_IN*1..3]->(w:Workpack:Project)
WHERE id(w) = $P!{idProjeto}
WITH m, parent, date(left(toString(coalesce(m.newDate, m.date)), 10)) AS dtMarco
// Risco usa IS_FORSEEN_ON e Issue usa IS_REPORTED_FOR. Os tres tipos consultados
// antes nao existem no grafo, e a coluna Ocorrencia saia sempre vazia.
OPTIONAL MATCH (o)-[:IS_FORSEEN_ON|IS_REPORTED_FOR]->(parent)
WHERE o:Risk OR o:Issue
WITH m, parent, dtMarco, collect(DISTINCT o.name) AS ocorrencias
RETURN
  CASE WHEN 'Deliverable' IN labels(parent) THEN parent.name ELSE '-' END AS entrega,
  m.name AS marco,
  CASE WHEN toString(dtMarco) IS NULL OR toString(dtMarco) = '' THEN '' ELSE substring(toString(dtMarco),8,2)+'/'+substring(toString(dtMarco),5,2)+'/'+substring(toString(dtMarco),0,4) END AS dataMarco,
  CASE WHEN m.canceled  THEN 'Cancelado'
       WHEN m.completed THEN 'Concluído'
       WHEN dtMarco < date() THEN 'Atrasado'
       ELSE 'No prazo' END AS statusMarco,
  reduce(s='', n IN [x IN ocorrencias WHERE x IS NOT NULL] | CASE WHEN s='' THEN n ELSE s + '; ' + n END) AS ocorrenciaRiscos
ORDER BY dataMarco, marco]]>
	</queryString>
	<field name="entrega" class="java.lang.String"/>
	<field name="marco" class="java.lang.String"/>
	<field name="dataMarco" class="java.lang.String"/>
	<field name="statusMarco" class="java.lang.String"/>
	<field name="ocorrenciaRiscos" class="java.lang.String"/>
	<columnHeader>
		<band height="18">
			<staticText><reportElement mode="Opaque" backcolor="#E8EDF3" x="0" y="0" width="32" height="18"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#9AA7B5"/></box><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText>
			<staticText><reportElement mode="Opaque" backcolor="#E8EDF3" x="32"   y="0" width="120" height="18"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#9AA7B5"/></box><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Entrega]]></text></staticText>
			<staticText><reportElement mode="Opaque" backcolor="#E8EDF3" x="152" y="0" width="175" height="18"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#9AA7B5"/></box><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Marco Crítico]]></text></staticText>
			<staticText><reportElement mode="Opaque" backcolor="#E8EDF3" x="327" y="0" width="58"  height="18"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#9AA7B5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Data]]></text></staticText>
			<staticText><reportElement mode="Opaque" backcolor="#E8EDF3" x="385" y="0" width="58"  height="18"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#9AA7B5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText>
			<staticText><reportElement mode="Opaque" backcolor="#E8EDF3" x="443" y="0" width="112" height="18"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#9AA7B5"/></box><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Ocorrência / Riscos]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="16">
			<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="32" height="16"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$P{idProjeto}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="32"   y="0" width="120" height="16"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{entrega}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="152" y="0" width="175" height="16"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{marco}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="327" y="0" width="58"  height="16"/><box><pen lineWidth="0.25" lineColor="#C4CCD6"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{dataMarco}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="385" y="0" width="58"  height="16"/><box><pen lineWidth="0.25" lineColor="#C4CCD6"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{statusMarco}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="443" y="0" width="112" height="16"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{ocorrenciaRiscos}]]></textFieldExpression></textField>
		</band>
	</detail>
	<noData>
		<band height="16">
			<staticText><reportElement x="0" y="0" width="555" height="16"/><box leftPadding="3"><pen lineWidth="0.25" lineColor="#C4CCD6"/></box><textElement verticalAlignment="Middle"><font size="7" isItalic="true"/></textElement><text><![CDATA[Nenhum marco crítico cadastrado para este projeto.]]></text></staticText>
		</band>
	</noData>
</jasperReport>
